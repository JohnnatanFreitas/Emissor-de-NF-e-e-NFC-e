# Copie para .env e preencha (guia COMO-INSTALAR-PAC-FATURAMENTO.md, seção 3).
# Gere cada chave com: openssl rand -hex 32

DB_SENHA=
MASTER_KEY=
JWT_SECRET=

# Primeiro acesso (apague ADMIN_SENHA depois de trocar a senha no sistema)
ADMIN_NOME=Seu Nome
ADMIN_EMAIL=seu@email.com
ADMIN_SENHA=

# Responsável técnico que vai na nota (infRespTec)
RESP_TEC_CNPJ=
RESP_TEC_CONTATO=
RESP_TEC_EMAIL=
RESP_TEC_FONE=

# Porta no seu computador: http://127.0.0.1:3000
HOST_PORT=3000

# --- Opcionais ---
# "sefaz" fala com a SEFAZ de verdade; "simulado" autoriza tudo localmente (só para testar telas, sem certificado).
# SEFAZ_MODO=sefaz
# SEFAZ_TIMEOUT=30
# COOKIE_SEGURO=1   # ligue quando o sistema estiver atrás de HTTPS (na Vercel já vem ligado)
# Na Vercel: veja docs/VERCEL.md (DATABASE_URL do Neon, sem DB_SENHA/HOST_PORT)

# --- Rodando sem Docker (npm start) ---
# Sem DATABASE_URL o sistema usa o PGlite (Postgres embutido) na pasta PGLITE_DIR.
# DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/emissor
# PGLITE_DIR=./dados/pglite
# PORT=3000
